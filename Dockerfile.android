# Dockerfile pour compiler l'APK Android
FROM ghcr.io/cirruslabs/flutter:stable AS build

# Build arguments
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION
ARG BUILD_TYPE=release

# Labels for metadata
LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="IMMO360 Frontend Android" \
      org.opencontainers.image.description="Application mobile Android Flutter pour IMMO360 CAMEROUN" \
      org.opencontainers.image.authors="IMMO360 Team" \
      org.opencontainers.image.url="https://github.com/immo360/frontend" \
      org.opencontainers.image.source="https://github.com/immo360/frontend" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.vendor="IMMO360 CAMEROUN"

# Install Java and Android SDK dependencies
RUN apt-get update && apt-get install -y \
    openjdk-17-jdk \
    unzip \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Set Java environment
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Accept Android licenses
RUN flutter doctor --android-licenses || true

# Set working directory
WORKDIR /app

# Copy pubspec files first for better caching
COPY pubspec.yaml pubspec.lock ./

# Get dependencies
RUN flutter pub get

# Copy source code
COPY . .

# Build APK
RUN flutter build apk --${BUILD_TYPE} --target-platform android-arm64,android-arm,android-x64

# Stage 2: Serve APK with nginx
FROM nginx:alpine

# Labels inherited from build stage
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION

LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="IMMO360 Frontend Android" \
      org.opencontainers.image.description="Application mobile Android Flutter pour IMMO360 CAMEROUN" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}"

# Copy APK from build stage
COPY --from=build /app/build/app/outputs/flutter-apk/*.apk /usr/share/nginx/html/

# Create simple HTML page for APK download
RUN echo '<!DOCTYPE html><html><head><meta charset="UTF-8"><title>IMMO360 Android APK</title><style>body{font-family:Arial,sans-serif;max-width:600px;margin:50px auto;padding:20px;text-align:center}h1{color:#2563EB}a{display:inline-block;margin-top:20px;padding:15px 30px;background:#2563EB;color:white;text-decoration:none;border-radius:8px}a:hover{background:#1D4ED8}</style></head><body><h1>📱 IMMO360 CAMEROUN</h1><p>Application mobile Android</p><p>Version: '${VERSION}'</p><a href="/app-release.apk" download>📥 Télécharger l'APK</a></body></html>' > /usr/share/nginx/html/index.html

# Configure nginx for APK download
RUN echo 'server { listen 80; server_name _; root /usr/share/nginx/html; index index.html; location / { try_files $uri $uri/ =404; } types { application/vnd.android.package-archive apk; } add_header Content-Disposition "attachment" .apk; }' > /etc/nginx/conf.d/default.conf

# Set proper permissions
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]

